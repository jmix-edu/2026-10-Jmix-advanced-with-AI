<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://myTimeEntries.title">
    <data>
        <collection id="timeEntriesDc" class="com.company.timesheets.entity.TimeEntry">
            <loader id="timeEntriesDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_TimeEntry e where e.user.id = :current_user_id]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <genericFilter dataLoader="timeEntriesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="createButton" action="timeEntriesDataGrid.create"/>
                <button id="copyButton" action="timeEntriesDataGrid.copy"/>
                <button id="editButton" action="timeEntriesDataGrid.edit"/>
                <button id="removeButton" action="timeEntriesDataGrid.remove"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="timeEntriesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="timeEntriesDataGrid"
                  dataContainer="timeEntriesDc"
                  width="100%" minWidth="100px"
        columnReorderingAllowed="true">
            <actions>
                <action id="create" type="list_create"/>
                <action id="copy" text="msg://copyAction.text" icon="COPY_O" type="list_itemTracking"/>
                <action id="edit" type="list_edit"/>
                <action id="remove" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="date" autoWidth="true" flexGrow="0"/>
                <column property="task"/>
                <column property="spentTime" autoWidth="true" flexGrow="0"/>
                <column property="status" autoWidth="true" flexGrow="0"/>
                <column property="description" flexGrow="2"/>
                <column property="rejectionReason" flexGrow="4"/>
            </columns>
        </dataGrid>
    </layout>
</view>