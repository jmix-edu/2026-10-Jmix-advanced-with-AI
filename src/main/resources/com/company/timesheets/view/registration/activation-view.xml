<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://activationView.title">
    <layout justifyContent="CENTER" alignItems="CENTER" classNames="jmix-login-main-layout">
        <vbox id="activationBox" classNames="registration-box" padding="false">
            <h2 text="msg://activationView.title"/>
            <!-- Показывается для действующей ссылки. -->
            <vbox id="activationForm" padding="false" visible="false" width="100%">
                <span id="welcomeText"/>
                <!-- Приглашённый подрядчик (spec 03/05) видит проекты, в которые войдёт. -->
                <span id="invitedText" visible="false"/>
                <passwordField id="passwordField" label="msg://password.label" required="true" width="100%"/>
                <passwordField id="confirmPasswordField" label="msg://confirmPassword.label" required="true"
                               width="100%"/>
                <button id="activateButton" text="msg://activate.text" themeNames="primary" width="100%"/>
            </vbox>
            <!-- Показывается для неизвестной, просроченной или использованной ссылки. -->
            <vbox id="invalidLinkBox" padding="false" visible="false" width="100%">
                <span text="msg://linkInvalid"/>
                <anchor id="registerLink" href="register" text="msg://registerAgain.text"/>
            </vbox>
        </vbox>
    </layout>
</view>
