<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://projectDetailView.title"
      focusComponent="form">
    <data>
        <instance id="projectDc"
                  class="com.company.timesheets.entity.Project">
            <fetchPlan extends="_base">
                <property name="client" fetchPlan="_base"/>
                <property name="tasks" fetchPlan="_base"/>
                <property name="participants" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="projectDl"/>
            <collection id="participantsDc" property="participants"/>
            <collection id="tasksDc" property="tasks"/>
        </instance>
        <collection id="clientsDc" class="com.company.timesheets.entity.Client">
            <loader id="clientsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_Client e]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>

    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="projectDc" maxWidth="40em">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
            </responsiveSteps>
            <textField id="nameField" property="name">
                <prefix>
                    <icon icon="USER_CARD"/>
                </prefix>
            </textField>
            <entityComboBox id="clientsComboBox" property="client"
                            itemsContainer="clientsDc" dataContainer="projectDc">
                <prefix>
                    <icon icon="USER"/>
                </prefix>
                <actions>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityComboBox>
            <textArea id="descriptionField" property="description" height="9.5em">
                <prefix>
                    <icon icon="COMMENT_O"/>
                </prefix>
            </textArea>
            <select id="statusField" property="status"/>
        </formLayout>

        <tabSheet id="tabSheet" width="100%" height="100%">
            <tab id="participantsTab" label="msg://com.company.timesheets.entity/Project.participants">
                <vbox height="100%">
                    <hbox id="participantsButtonsPanel" wrap="true" width="100%">
                        <button action="participantsDataGrid.createAction"/>
                        <button action="participantsDataGrid.editAction"/>
                        <button action="participantsDataGrid.removeAction"/>
                    </hbox>
                    <dataGrid id="participantsDataGrid" dataContainer="participantsDc" width="100%" height="100%">
                        <actions>
                            <action id="createAction" type="list_create">
                                <properties>
                                    <property name="openMode" value="DIALOG"/>
                                </properties>
                            </action>
                            <action id="editAction" type="list_edit">
                                <properties>
                                    <property name="openMode" value="DIALOG"/>
                                </properties>
                            </action>
                            <action id="removeAction" type="list_remove"/>
                        </actions>
                        <columns>
                            <column property="user"/>
                            <column property="projectRole"/>
                        </columns>
                    </dataGrid>
                </vbox>
            </tab>

            <tab id="tasksTab" label="msg://com.company.timesheets.entity/Project.tasks">
                <vbox height="100%">
                    <hbox id="tasksButtonsPanel" wrap="true" width="100%">
                        <button action="tasksDataGrid.createAction"/>
                        <button action="tasksDataGrid.editAction"/>
                        <button action="tasksDataGrid.removeAction"/>
                    </hbox>
                    <dataGrid id="tasksDataGrid" dataContainer="tasksDc" width="100%" height="100%">
                        <actions>
                            <action id="createAction" type="list_create">
                                <properties>
                                    <property name="openMode" value="DIALOG"/>
                                </properties>
                            </action>
                            <action id="editAction" type="list_edit">
                                <properties>
                                    <property name="openMode" value="DIALOG"/>
                                </properties>
                            </action>
                            <action id="removeAction" type="list_remove"/>
                        </actions>
                        <columns>
                            <column property="name"/>
                            <column property="description"/>
                            <column property="status"/>
                        </columns>
                    </dataGrid>
                </vbox>
            </tab>
        </tabSheet>



        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
