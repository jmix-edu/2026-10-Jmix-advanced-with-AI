<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://projectDetailView.title"
      focusComponent="form">
    <data>
        <instance id="projectDc"
                  class="com.company.timesheets.entity.Project">
            <fetchPlan extends="_base">
                <property name="client" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="projectDl"/>
        </instance>
        <collection id="clientsDc" class="com.company.timesheets.entity.Client">
            <loader id="clientsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_Client e]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
        <!-- Участники и задачи проекта: загрузчики запускаются из контроллера при выборе вкладки
             (ProjectDetailView.initParticipants/initTasks), параметр :project ставится там же. -->
        <collection id="participantsDc" class="com.company.timesheets.entity.ProjectParticipant">
            <loader id="participantsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_ProjectParticipant e where e.project = :project]]>
                </query>
            </loader>
            <fetchPlan extends="_base">
                <property name="projectRole" fetchPlan="_base"/>
            </fetchPlan>
        </collection>
        <collection id="tasksDc" class="com.company.timesheets.entity.Task">
            <loader id="tasksDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_Task e where e.project = :project]]>
                </query>
            </loader>
            <fetchPlan extends="_base">
                <property name="taskType" fetchPlan="_instance_name"/>
            </fetchPlan>
        </collection>
    </data>
    <facets>
        <!-- auto="false": при открытии формы грузим только проект и клиентов.
             participantsDl и tasksDl сюда не входят, их грузит контроллер. -->
        <dataLoadCoordinator auto="false">
            <refresh loader="projectDl">
                <onViewEvent type="BeforeShow"/>
            </refresh>
            <refresh loader="clientsDl">
                <onViewEvent type="BeforeShow"/>
            </refresh>
        </dataLoadCoordinator>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="saveAction" type="detail_save"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <tabSheet id="tabSheet" width="100%" height="100%">
            <tab id="projectTab" label="msg://com.company.timesheets.entity/Project">
                <formLayout id="form" dataContainer="projectDc" maxWidth="40em">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="1"/>
                    </responsiveSteps>
                    <textField id="nameField" property="name">
                        <prefix>
                            <icon icon="USER_CARD"/>
                        </prefix>
                    </textField>
                    <entityComboBox id="clientsComboBox" property="client"
                                    itemsContainer="clientsDc" dataContainer="projectDc">
                        <prefix>
                            <icon icon="USER"/>
                        </prefix>
                        <actions>
                            <action id="entityClearAction" type="entity_clear"/>
                        </actions>
                    </entityComboBox>
                    <textArea id="descriptionField" property="description" height="9.5em">
                        <prefix>
                            <icon icon="COMMENT_O"/>
                        </prefix>
                    </textArea>
                    <select id="statusField" property="status"/>
                </formLayout>
            </tab>
            <!-- lazy="true": содержимое вкладки создаётся при первом выборе,
                 до этого гридов и их действий на форме нет. -->
            <tab id="participantsTab" label="msg://com.company.timesheets.entity/Project.participants" lazy="true">
                <vbox height="100%">
                    <hbox id="participantsButtonsPanel" wrap="true" width="100%">
                        <startSlot>
                            <button action="participantsDataGrid.createAction"/>
                            <button action="participantsDataGrid.editAction"/>
                            <button action="participantsDataGrid.removeAction"/>
                        </startSlot>
                        <endSlot>
                            <simplePagination id="participantsSimplePagination" dataLoader="participantsDl"/>
                        </endSlot>
                    </hbox>
                    <dataGrid id="participantsDataGrid" dataContainer="participantsDc" width="100%" height="100%">
                        <actions>
                            <action id="createAction" type="list_create"/>
                            <action id="editAction" type="list_edit"/>
                            <action id="removeAction" type="list_remove"/>
                        </actions>
                        <columns>
                            <column property="user"/>
                            <column property="projectRole"/>
                        </columns>
                    </dataGrid>
                </vbox>
            </tab>

            <tab id="tasksTab" label="msg://com.company.timesheets.entity/Project.tasks" lazy="true">
                <vbox height="100%">
                    <hbox id="tasksButtonsPanel" wrap="true" width="100%">
                        <startSlot>
                            <button action="tasksDataGrid.createAction"/>
                            <button action="tasksDataGrid.editAction"/>
                            <button action="tasksDataGrid.removeAction"/>
                        </startSlot>
                        <endSlot>
                            <simplePagination id="tasksSimplePagination" dataLoader="tasksDl"/>
                        </endSlot>
                    </hbox>
                    <dataGrid id="tasksDataGrid" dataContainer="tasksDc" width="100%" height="100%">
                        <actions>
                            <action id="createAction" type="list_create"/>
                            <action id="editAction" type="list_edit"/>
                            <action id="removeAction" type="list_remove"/>
                        </actions>
                        <columns>
                            <column property="name"/>
                            <column property="taskType"/>
                            <column property="description"/>
                            <column property="status"/>
                        </columns>
                    </dataGrid>
                </vbox>
            </tab>
        </tabSheet>


        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="saveButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
