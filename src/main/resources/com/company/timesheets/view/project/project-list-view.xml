<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://projectListView.title"
      focusComponent="projectsDataGrid">
    <data>
        <collection id="projectsDc"
                    class="com.company.timesheets.entity.Project">
            <fetchPlan extends="_base">
                <property name="client" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="projectsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_Project e]]>
                    <condition>
                        <c:jpql>
                            <c:where>:onlyMine = true and exists (select p from ts_ProjectParticipant p
                                where p.project = {E} and p.user.id = :current_user_id)</c:where>
                        </c:jpql>
                    </condition>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="false">
            <refresh loader="projectsDl">
                <onViewEvent type="BeforeShow"/>
            </refresh>
        </dataLoadCoordinator>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="projectsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="createButton" action="projectsDataGrid.createAction"/>
                <button id="editButton" action="projectsDataGrid.editAction"/>
                <button id="removeButton" action="projectsDataGrid.removeAction"/>
                <button id="closeMonthButton" action="projectsDataGrid.closeMonthAction"/>
                <checkbox id="onlyMyProjectsField" label="msg://onlyMyProjectsField.label"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="projectsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="projectsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="projectsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
                <action id="closeMonthAction" type="list_itemTracking" text="msg://closeMonthAction.text"/>
            </actions>
            <columns resizable="true">
                <column property="name"/>
                <column property="client"/>
                <column property="description"/>
                <column property="status"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
