<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://projectCardsView.title">
    <data>
        <!-- Calculated by HoursReportService, see the load delegate in the controller. -->
        <collection id="projectSummariesDc" class="com.company.timesheets.entity.ProjectSummary">
            <loader id="projectSummariesDl" readOnly="true"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <!-- Cards are added by the controller; the grid layout is in view/project-cards.css. -->
        <div id="cardsContainer" classNames="project-cards" width="100%"/>
    </layout>
</view>
