<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://projectCardsView.title">
    <data>
        <!-- Считает HoursReportService, см. load-делегат в контроллере. -->
        <collection id="projectSummariesDc" class="com.company.timesheets.entity.ProjectSummary">
            <loader id="projectSummariesDl" readOnly="true"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <!-- Карточки добавляет контроллер; раскладка сетки — в view/project-cards.css. -->
        <div id="cardsContainer" classNames="project-cards" width="100%"/>
    </layout>
</view>
