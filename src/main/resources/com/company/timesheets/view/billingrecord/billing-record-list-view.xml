<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://billingRecordListView.title"
      focusComponent="billingRecordsDataGrid">
    <data>
        <collection id="billingRecordsDc"
                    class="com.company.timesheets.entity.BillingRecord">
            <fetchPlan extends="_base"/>
            <loader id="billingRecordsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_BillingRecord e order by e.month desc, e.projectName, e.username]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="billingRecordsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="refreshButton" action="billingRecordsDataGrid.refreshAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="billingRecordsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="billingRecordsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="billingRecordsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="refreshAction" type="list_refresh"/>
            </actions>
            <columns resizable="true">
                <column property="projectName"/>
                <column property="username"/>
                <column property="month"/>
                <column property="spentTime"/>
                <column property="closedDate"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
