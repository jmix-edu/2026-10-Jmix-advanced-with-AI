<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://clientLookupView.title"
      focusComponent="clientsDataGrid">
    <data>
        <collection id="clientsDc"
                    class="com.company.timesheets.entity.Client">
            <fetchPlan extends="_base"/>
            <loader id="clientsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_Client e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <propertyFilter id="nameFilter"
                        dataLoader="clientsDl"
                        labelVisible="false"
                        operationEditable="true"
                        property="name"
                        operation="CONTAINS">
            <textField id="nameFilterField" placeholder="msg://nameFilterField.placeholder">
                <prefix>
                    <icon icon="SEARCH"/>
                </prefix>
            </textField>
        </propertyFilter>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="readButton" action="clientsDataGrid.readAction"/>
                <button id="refreshButton" action="clientsDataGrid.refreshAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="clientsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="clientsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="clientsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="readAction" type="list_read"/>
                <action id="refreshAction" type="list_refresh"/>
            </actions>
            <columns resizable="true">
                <column property="name"/>
                <column property="contactInformation.email"/>
                <column property="contactInformation.phone"/>
                <column property="contactInformation.address"/>
                <column property="contactInformation.url"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
