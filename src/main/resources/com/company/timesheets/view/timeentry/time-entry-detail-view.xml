<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:ts="http://company.com/timesheets/schema/components"
      title="msg://timeEntryDetailView.title"
      focusComponent="form">
    <data>
        <instance id="timeEntryDc"
                  class="com.company.timesheets.entity.TimeEntry">
            <fetchPlan extends="_base">
                <property name="user" fetchPlan="_base"/>
                <property name="task" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="timeEntryDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <!-- Status badge right under the title: the title itself belongs to the dialog or the main view. -->
        <span id="statusBadge"/>
        <formLayout id="form" dataContainer="timeEntryDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <datePicker id="dateField" property="date">
                <prefix>
                    <icon icon="CALENDAR"/>
                </prefix>
            </datePicker>
            <entityComboBox id="userField" property="user" readOnly="true">
                <prefix>
                    <icon icon="USER"/>
                </prefix>
                <actions>
                    <action id="assignSelf" icon="USER_CHECK" description="msg://assignSelf.description"/>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
                <itemsQuery class="com.company.timesheets.entity.User"
                            searchStringFormat="(?i)%${inputString}%"
                            escapeValueForLike="true">
                    <fetchPlan extends="_instance_name"/>
                    <query>
                        <![CDATA[select e from ts_User e
                                 where e.username like :searchString
                                    or e.firstName like :searchString
                                    or e.lastName like :searchString
                                 escape '\' order by e.username asc]]>
                    </query>
                </itemsQuery>
            </entityComboBox>
            <entityComboBox id="taskField" property="task">
                <prefix>
                    <icon icon="FILE_TEXT_O"/>
                </prefix>
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityComboBox>
            <ts:spentTimeField id="spentTimeField" property="spentTime" colspan="2"/>
            <select id="statusField" property="status"/>
            <textArea id="descriptionField" height="9.5em" property="description" colspan="2">
                <prefix>
                    <icon icon="COMMENT_O"/>
                </prefix>
            </textArea>
            <textArea id="rejectionReasonField" height="9.5em" property="rejectionReason" colspan="2"
                      required="true">
                <prefix>
                    <icon icon="EXCLAMATION_CIRCLE_O"/>
                </prefix>
            </textArea>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
