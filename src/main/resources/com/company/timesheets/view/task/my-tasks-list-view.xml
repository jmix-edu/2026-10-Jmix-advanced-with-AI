<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://myTasksListView.title"
      focusComponent="tasksDataGrid">
    <data>
        <collection id="tasksDc"
                    class="com.company.timesheets.entity.Task">
            <fetchPlan extends="_base">
                <property name="taskType" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="tasksDl" readOnly="true">
                <query>
                    <![CDATA[select e from ts_Task e
                     where e.project.status = @enum(com.company.timesheets.entity.ProjectStatus.OPEN)
                       and e.status = @enum(com.company.timesheets.entity.TaskStatus.ACTIVE)
                       and exists (select pp from ts_ProjectParticipant pp
                                   where pp.project = e.project and pp.user.username = :current_user_username)
                     order by e.project.name asc, e.name asc]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="tasksDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="readButton" action="tasksDataGrid.readAction"/>
                <button id="refreshButton" action="tasksDataGrid.refreshAction"/>
                <button id="createTimeEntryButton" action="tasksDataGrid.createTimeEntryAction"
                        text="msg://createTimeEntryButton.text"
                        icon="CLOCK"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="tasksDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="tasksDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="tasksDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="readAction" type="list_read"/>
                <action id="refreshAction" type="list_refresh"/>
                <action id="createTimeEntryAction" type="list_itemTracking"/>
            </actions>
            <columns resizable="true">
                <column property="name"/>
                <column property="description"/>
                <column property="status"/>
                <column property="project"/>
                <column property="taskType"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
