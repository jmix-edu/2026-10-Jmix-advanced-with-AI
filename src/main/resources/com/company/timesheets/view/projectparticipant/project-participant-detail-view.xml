<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://projectParticipantDetailView.title"
      focusComponent="form">
    <data>
        <instance id="projectParticipantDc"
                  class="com.company.timesheets.entity.ProjectParticipant">
            <fetchPlan extends="_base">
                <property name="projectRole" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="projectParticipantDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="projectParticipantDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <entityComboBox id="userField" property="user">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
                <itemsQuery class="com.company.timesheets.entity.User"
                            searchStringFormat="%${inputString}%"
                            escapeValueForLike="true">
                    <fetchPlan extends="_base"/>
                    <query>
                        select e from ts_User e
                            where e.username like :searchString
                            or e.firstName like :searchString
                            or e.lastName like :searchString
                            escape '\' order by e.username asc
                    </query>
                </itemsQuery>
            </entityComboBox>
            <entityPicker id="projectRoleField" property="projectRole">
                <actions>
                    <action id="entityCreateAction" text="msg:///actions.Create" icon="PLUS"/>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
