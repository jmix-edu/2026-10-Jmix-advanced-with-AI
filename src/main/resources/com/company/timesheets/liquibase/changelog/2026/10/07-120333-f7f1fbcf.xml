<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="com/company/timesheets/liquibase/changelog/2026/10/07-120333-f7f1fbcf.xml">
    <changeSet id="1" author="ts">
        <createTable tableName="TS_CLIENT">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_TS_CLIENT"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="IMAGE" type="${byte[].type}"/>
            <column name="CONTACT_INFORMATION_EMAIL" type="VARCHAR(255)"/>
            <column name="CONTACT_INFORMATION_PHONE" type="VARCHAR(255)"/>
            <column name="CONTACT_INFORMATION_ADDRESS" type="CLOB"/>
            <column name="CONTACT_INFORMATION_URL" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="ts">
        <createTable tableName="TS_TASK_TYPE">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_TS_TASK_TYPE"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="CLOB"/>
        </createTable>
    </changeSet>
    <changeSet id="3" author="ts">
        <addColumn tableName="TS_PROJECT">
            <column name="CLIENT_ID" type="UUID"/>
        </addColumn>

        <addNotNullConstraint columnName="CLIENT_ID" tableName="TS_PROJECT"/>
    </changeSet>
    <changeSet id="4" author="ts">
        <addColumn tableName="TS_PROJECT">
            <column name="DESCRIPTION" type="CLOB"/>
        </addColumn>
    </changeSet>
    <changeSet id="5" author="ts">
        <addColumn tableName="TS_TASK">
            <column name="DESCRIPTION" type="CLOB"/>
            <column name="TASK_TYPE_ID" type="UUID"/>
        </addColumn>
    </changeSet>
    <changeSet id="6" author="ts">
        <addColumn tableName="TS_PROJECT">
            <column name="STATUS" type="VARCHAR(255)"/>
        </addColumn>

        <addNotNullConstraint columnName="STATUS" tableName="TS_PROJECT"/>
    </changeSet>
    <changeSet id="7" author="ts">
        <addColumn tableName="TS_TASK">
            <column name="STATUS" type="VARCHAR(255)"/>
        </addColumn>

        <addNotNullConstraint columnName="STATUS" tableName="TS_TASK"/>
    </changeSet>
    <changeSet id="8" author="ts">
        <createIndex indexName="IDX_TS_PROJECT_ON_CLIENT" tableName="TS_PROJECT">
            <column name="CLIENT_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="CLIENT_ID" baseTableName="TS_PROJECT"
                                 constraintName="FK_TS_PROJECT_ON_CLIENT" referencedColumnNames="ID"
                                 referencedTableName="TS_CLIENT"/>
    </changeSet>
    <changeSet id="9" author="ts">
        <createIndex indexName="IDX_TS_TASK_ON_TASK_TYPE" tableName="TS_TASK">
            <column name="TASK_TYPE_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="TASK_TYPE_ID" baseTableName="TS_TASK"
                                 constraintName="FK_TS_TASK_ON_TASK_TYPE" referencedColumnNames="ID"
                                 referencedTableName="TS_TASK_TYPE"/>
    </changeSet>
</databaseChangeLog>